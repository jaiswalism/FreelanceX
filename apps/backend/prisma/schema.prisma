datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  address           String             @unique // 0x... lowercase
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  jobs              Job[]
  proposals         Proposal[]
  clientProjects    Project[]          @relation("ClientProjects")
  freelancerProjects Project[]         @relation("FreelancerProjects")
  sessions          Session[]
  nonces            AuthNonce[]
  disputesRaised    Dispute[]
  sentMessages      ProjectMessage[]
}

model FreelancerProfile {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  avatarUrl              String?
  bio                    String?
  title                  String?
  hourlyRate             Decimal?        @db.Decimal(10, 2)
  completedProjectsCount Int             @default(0)
  verifiedProjectsCount  Int             @default(0)
  rating                 Decimal         @default(0.0) @db.Decimal(3, 2)
  totalEarningsUsdc      Decimal         @default(0.0) @db.Decimal(16, 6)
  skills                 String[]
  portfolio              PortfolioItem[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model ClientProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  companyName            String?
  avatarUrl              String?
  description            String?
  website                String?
  totalSpentUsdc         Decimal   @default(0.0) @db.Decimal(16, 6)
  hiredProjectsCount     Int       @default(0)
  completedProjectsCount Int       @default(0)
  rating                 Decimal   @default(0.0) @db.Decimal(3, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model PortfolioItem {
  id                 String            @id @default(uuid())
  freelancerId       String
  freelancer         FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  link               String?
  imageUrl           String?
  tags               String[]
  verifiedOnChain    Boolean           @default(false)
  projectContractId  String?
  createdAt          DateTime          @default(now())
}

enum JobStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id                    String     @id @default(uuid())
  clientId              String
  client                User       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  skills                String[]
  budgetUsdc            Decimal    @db.Decimal(16, 6)
  budgetBaseUnits       String     // 6 decimals raw integer string
  estimatedDurationDays Int?
  status                JobStatus  @default(OPEN)
  proposals             Proposal[]
  project               Project?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Proposal {
  id                   String         @id @default(uuid())
  jobId                String
  job                  Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId         String
  freelancer           User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  coverLetter          String
  proposedPriceUsdc    Decimal        @db.Decimal(16, 6)
  proposedDurationDays Int
  milestonePlan        Json           // ProposedMilestone[]
  status               ProposalStatus @default(PENDING)
  project              Project?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

enum ProjectStatus {
  INITIALIZED
  FUNDED
  IN_PROGRESS
  DISPUTED
  COMPLETED
  CANCELLED
}

model Project {
  id                    String             @id @default(uuid())
  onChainProjectId      String?            @unique // ID in smart contract
  jobId                 String             @unique
  job                   Job                @relation(fields: [jobId], references: [id])
  proposalId            String             @unique
  proposal              Proposal           @relation(fields: [proposalId], references: [id])
  clientId              String
  client                User               @relation("ClientProjects", fields: [clientId], references: [id])
  freelancerId          String
  freelancer            User               @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  title                 String
  totalAmountUsdc       Decimal            @db.Decimal(16, 6)
  totalAmountBaseUnits  String
  escrowContractAddress String
  status                ProjectStatus      @default(INITIALIZED)
  fundedTxHash          String?
  completedTxHash       String?
  milestones            ProjectMilestone[]
  disputes              Dispute[]
  messages              ProjectMessage[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

enum MilestoneStatus {
  PENDING
  FUNDED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  PAID
  DISPUTED
  CANCELLED
}

model ProjectMilestone {
  id                     String          @id @default(uuid())
  projectId              String
  project                Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index                  Int
  title                  String
  description            String
  amountUsdc             Decimal         @db.Decimal(16, 6)
  amountBaseUnits        String
  deadline               DateTime?
  status                 MilestoneStatus @default(PENDING)
  deliverableDescription String?
  deliverableUri         String?
  submissionDate         DateTime?
  paidDate               DateTime?
  paymentTxHash          String?
  disputes               Dispute[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([projectId, index])
}

enum DisputeOutcome {
  PAY_FREELANCER
  REFUND_CLIENT
  SPLIT_FUNDS
}

model Dispute {
  id              String            @id @default(uuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id])
  raisedById      String
  raisedBy        User              @relation(fields: [raisedById], references: [id])
  reason          String
  evidenceUris    String[]
  outcome         DisputeOutcome?
  resolvedTxHash  String?
  isResolved      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?
}

model BlockchainEvent {
  id              String   @id @default(uuid())
  eventName       String
  contractAddress String
  transactionHash String
  blockNumber     BigInt
  logIndex        Int
  args            Json
  createdAt       DateTime @default(now())

  @@unique([transactionHash, logIndex])
}

model IndexedBlock {
  chainId      Int      @id
  lastBlock    BigInt
  updatedAt    DateTime @updatedAt
}

model AuthNonce {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String   // 0x...
  nonce     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProjectMessage {
  id                   String   @id @default(uuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId             String
  sender               User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content              String
  attachmentUri        String?
  isSystemNotification Boolean  @default(false)
  createdAt            DateTime @default(now())
}
